        RBegin
        ()
        {
            Return cmotive_stl_vector_any_rbegin(handle, Sizeof(T));
        }

        Void*
        REnd
        ()
        {
            Return cmotive_stl_vector_any_rend(handle);
        }

        Void
        Sort
        ()
        {
            cmotive_stl_vector_any_sort_i64(handle);
        }

