        other : Vector<T>*
        ()
        {
            cmotive_stl_vector_any_swap(handle, other->handle);
        }

        Void*
        Begin
        ()
        {
            Return cmotive_stl_vector_any_begin(handle);
        }

        Void*
        End
        ()
        {
            Return cmotive_stl_vector_any_end(handle, Sizeof(T));
        }

        Void*
        CBegin
        ()
        {
            Return cmotive_stl_vector_any_begin(handle);
        }

        Void*
        CEnd
        ()
        {
            Return cmotive_stl_vector_any_end(handle, Sizeof(T));
        }

