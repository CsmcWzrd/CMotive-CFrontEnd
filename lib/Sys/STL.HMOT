        BinarySearch
        value : T
        ()
        {
            Return cmotive_stl_vector_any_binary_search_i64(handle, *((Int*)&value));
        }

        Int
        LinearSearch
        value : T
        ()
        {
            Return cmotive_stl_vector_any_find_i64(handle, *((Int*)&value));
        }

        Boolean
        Contains
        value : T
        ()
        {
            Return cmotive_stl_vector_any_find_i64(handle, *((Int*)&value)) >= 0;
        }

    }
};
