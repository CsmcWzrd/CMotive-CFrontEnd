        Clear
        ()
        {
            cmotive_stl_vector_any_clear(handle);
        }

        Void
        Insert
        index : Uint
        value : T
        ()
        {
            cmotive_stl_vector_any_insert(handle, index, &value, Sizeof(T));
        }

        Void
        Emplace
        index : Uint
        value : T
        ()
        {
            cmotive_stl_vector_any_insert(handle, index, &value, Sizeof(T));
        }

        Void
        Erase
        index : Uint
        ()
        {
            cmotive_stl_vector_any_erase(handle, index, Sizeof(T));
        }

        Void
        PushBack
        value : T
        ()
        {
            cmotive_stl_vector_any_push_back(handle, &value, Sizeof(T));
        }

        Void
        EmplaceBack
        value : T
        ()
        {
            cmotive_stl_vector_any_push_back(handle, &value, Sizeof(T));
        }

        T
        PopBack
        ()
        {
            out : T = 0;
            cmotive_stl_vector_any_pop_back(handle, &out, Sizeof(T));
            Return out;
        }

        Void
        Resize
        count : Uint
        ()
        {
            cmotive_stl_vector_any_resize(handle, count, Null, Sizeof(T));
        }

        Void
        ResizeFill
        count : Uint
        value : T
        ()
        {
