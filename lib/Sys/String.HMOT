// Parses text into an opaque List<List<Char*>> / Vector<Vector<Char*>> compatible
// table handle.  Use str_parse_rows/cols/at and str_parse_free for access.
Void*
str_parse
input : Char*
record_delimiters : Char*
field_delimiters : Char*
escape : Char
()
{
    Return cmotive_sys_string_str_parse(input, record_delimiters, field_delimiters, escape);
}

U64
str_parse_rows
table : Void*
()
{
    Return cmotive_sys_string_str_parse_rows(table);
}

U64
str_parse_cols
table : Void*
row : U64
()
{
    Return cmotive_sys_string_str_parse_cols(table, row);
}

Char*
str_parse_at
table : Void*
row : U64
col : U64
()
{
    Return cmotive_sys_string_str_parse_at(table, row, col);
}

Void
str_parse_free
table : Void*
()
{
    cmotive_sys_string_str_parse_free(table);
    Return;
}

