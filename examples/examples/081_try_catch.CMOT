// CMotive verified example 081: try_catch
// Coverage: exceptions try/catch scaffold
func generic_identity(x) : Int { return x; }
func main() : Int {
  Sys::Stdio::print("example 081: try_catch\n");
  var value = 81;
  if (value >= 0) {
    value = value + 1;
  } else {
    value = 0;
  }
  return 0;
}
