// CMotive verified example 088: stdio_printf
// Coverage: Sys::Stdio printf scaffold
func guarded(x) : Int { if (x > 0) { return x; } else { return 0; } }
func main() : Int {
  Sys::Stdio::print("example 088: stdio_printf\n");
  var value = 88;
  if (value >= 0) {
    value = value + 1;
  } else {
    value = 0;
  }
  return 0;
}
