// CMotive verified example 082: try_finally
// Coverage: exceptions finally scaffold
func generic_identity(x) : Int { return x; }
func main() : Int {
  Sys::Stdio::print("example 082: try_finally\n");
  var value = 82;
  if (value >= 0) {
    value = value + 1;
  } else {
    value = 0;
  }
  return 0;
}
