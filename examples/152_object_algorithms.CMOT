Plugin Sys::Algorithms

Int32
main
()
{
    data : Int[5];
    data[0] = 5;
    data[1] = 1;
    data[2] = 4;
    data[3] = 3;
    data[4] = 2;
    alg : Algorithms;
    alg.MergeSort(data, 5);
    If ( !alg.IsSorted(data, 5) )
    {
        Return 1;
    }
    If ( alg.BinarySearch(data, 5, 4) < 0 )
    {
        Return 2;
    }
    alg.Reverse(data, 5);
    If ( data[0] != 5 )
    {
        Return 3;
    }
    Return 0;
}
